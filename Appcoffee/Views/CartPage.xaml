<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Appcoffee.Views.CartPage" x:Name="Page" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" BackgroundColor="{StaticResource Cream}"><Grid RowDefinitions="Auto,*,Auto" Padding="20,15"><Grid ColumnDefinitions="Auto,*"><Button Text="‹" Command="{Binding GoBackCommand}" BackgroundColor="Transparent" TextColor="{StaticResource CoffeeBrown}" FontSize="30" Padding="0"/><Label Grid.Column="1" Text="My Cart" Style="{StaticResource TitleStyle}" VerticalOptions="Center"/></Grid><CollectionView Grid.Row="1" ItemsSource="{Binding Items}" EmptyView="Your cart is waiting for coffee." Margin="0,15"><CollectionView.ItemTemplate><DataTemplate><Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="10" Margin="0,5"><Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="10"><Image Source="{Binding Product.Image}" HeightRequest="65"/><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="{Binding Product.Name}" FontAttributes="Bold" TextColor="{StaticResource CoffeeBrown}"/><Label Text="{Binding Size}" TextColor="#8B6B55"/><Label Text="{Binding UnitPrice, StringFormat='${0:F2} each'}" TextColor="#8B6B55"/></VerticalStackLayout><VerticalStackLayout Grid.Column="2" HorizontalOptions="End"><Button Text="×" Command="{Binding Source={x:Reference Page}, Path=BindingContext.RemoveCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="#8B6B55" Padding="0" HeightRequest="30"/><HorizontalStackLayout><Button Text="−" Command="{Binding Source={x:Reference Page}, Path=BindingContext.DecreaseCommand}" CommandParameter="{Binding .}" BackgroundColor="{StaticResource Beige}" Padding="8,0"/><Label Text="{Binding Qty}" Padding="10,0" VerticalOptions="Center"/><Button Text="+" Command="{Binding Source={x:Reference Page}, Path=BindingContext.IncreaseCommand}" CommandParameter="{Binding .}" BackgroundColor="{StaticResource Beige}" Padding="8,0"/></HorizontalStackLayout><Label Text="{Binding LineTotal, StringFormat='${0:F2}'}" FontAttributes="Bold" HorizontalTextAlignment="End" TextColor="{StaticResource CoffeeBrown}"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView><VerticalStackLayout Grid.Row="2" Spacing="8"><Grid ColumnDefinitions="*,Auto"><Entry Placeholder="Discount code" Text="{Binding DiscountCode}" BackgroundColor="White"/><Button Grid.Column="1" Text="Apply" Command="{Binding ApplyDiscountCommand}" Margin="8,0,0,0"/></Grid><Label Text="{Binding DiscountError}" TextColor="#B33A3A" IsVisible="{Binding DiscountError, Converter={StaticResource StringNotEmptyConverter}}"/><Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16"><Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="7"><Label Text="Subtotal"/><Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:F2}'}"/><Label Grid.Row="1" Text="Delivery"/><Label Grid.Row="1" Grid.Column="1" Text="{Binding Delivery, StringFormat='${0:F2}'}"/><Label Grid.Row="2" Text="Tax (5%)"/><Label Grid.Row="2" Grid.Column="1" Text="{Binding Tax, StringFormat='${0:F2}'}"/><Label Grid.Row="3" Text="Total" FontAttributes="Bold"/><Label Grid.Row="3" Grid.Column="1" Text="{Binding Total, StringFormat='${0:F2}'}" FontAttributes="Bold"/></Grid></Border><Button Text="Proceed to Checkout" Command="{Binding CheckoutCommand}" Style="{StaticResource PillButtonStyle}" HeightRequest="52"/><Label Text="{Binding ConfirmationMessage}" TextColor="#3B7A43" HorizontalTextAlignment="Center"/></VerticalStackLayout></Grid></ContentPage>