<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Appcoffee.Views.ListPage" x:Name="Page" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" BackgroundColor="{StaticResource Cream}">
 <Grid RowDefinitions="Auto,*" Padding="20,15"><Grid ColumnDefinitions="Auto,*"><Button Text="‹" Command="{Binding GoBackCommand}" BackgroundColor="Transparent" TextColor="{StaticResource CoffeeBrown}" FontSize="30" Padding="0"/><Label Grid.Column="1" Text="All Coffees" Style="{StaticResource TitleStyle}" VerticalOptions="Center"/></Grid><CollectionView Grid.Row="1" ItemsSource="{Binding Products}" SelectionMode="None" Margin="0,15"><CollectionView.ItemTemplate><DataTemplate><Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="12" Margin="0,6"><Grid ColumnDefinitions="120,*" ColumnSpacing="15"><Image Source="{Binding Image}" HeightRequest="120" Aspect="AspectFit"/><VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6"><Label Text="{Binding Name}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource CoffeeBrown}"/><Label Text="★★★★☆" TextColor="{StaticResource Amber}"/><Label Text="{Binding Category}" TextColor="#8B6B55"/><Label Text="{Binding BasePrice, StringFormat='${0:F2}'}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource CoffeeBrown}"/></VerticalStackLayout><Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenProductCommand}" CommandParameter="{Binding .}"/></Grid.GestureRecognizers></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
</ContentPage>