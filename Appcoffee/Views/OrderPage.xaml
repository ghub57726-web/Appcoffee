<?xml version="1.0" encoding="utf-8" ?><ContentPage x:Class="Appcoffee.Views.OrderPage" x:Name="Page" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" BackgroundColor="{StaticResource Cream}"><Grid RowDefinitions="Auto,*" Padding="20,15"><Grid ColumnDefinitions="Auto,*"><Button Text="‹" Command="{Binding GoBackCommand}" BackgroundColor="Transparent" TextColor="{StaticResource CoffeeBrown}" FontSize="30" Padding="0"/><Label Grid.Column="1" Text="My Orders" Style="{StaticResource TitleStyle}"/></Grid><CollectionView Grid.Row="1" ItemsSource="{Binding Orders}" EmptyView="No orders yet. Your next coffee is one tap away." Margin="0,15"><CollectionView.ItemTemplate><DataTemplate><Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="16" Margin="0,5"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"><Label Text="{Binding Id}" FontAttributes="Bold" TextColor="{StaticResource CoffeeBrown}"/><Label Grid.Column="1" Text="{Binding Total, StringFormat='${0:F2}'}" FontAttributes="Bold" TextColor="{StaticResource CoffeeBrown}"/><Label Grid.Row="1" Text="{Binding Date, StringFormat='{0:MMM d, yyyy · h:mm tt}'}" TextColor="#8B6B55"/><Label Grid.Row="1" Grid.Column="1" Text="Completed" TextColor="#3B7A43"/></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></ContentPage>