<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Appcoffee.Views.ProductDetailPage" x:Name="Page" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" BackgroundColor="{StaticResource Cream}" Shell.NavBarIsVisible="False">
 <Grid RowDefinitions="*,Auto" BackgroundColor="{StaticResource Beige}"><Grid><Image Source="{Binding Product.Image}" Aspect="AspectFit" Margin="35"/><Button Text="‹" Command="{Binding GoBackCommand}" BackgroundColor="White" TextColor="{StaticResource CoffeeBrown}" CornerRadius="22" WidthRequest="45" HeightRequest="45" HorizontalOptions="Start" VerticalOptions="Start"/><Button Text="♡" Command="{Binding ToggleFavoriteCommand}" BackgroundColor="White" TextColor="{StaticResource CoffeeBrown}" CornerRadius="22" WidthRequest="45" HeightRequest="45" HorizontalOptions="End" VerticalOptions="Start"/></Grid><Border Grid.Row="1" BackgroundColor="{StaticResource Cream}" StrokeThickness="0" StrokeShape="RoundRectangle 28,28,0,0" Padding="22,25,22,18"><VerticalStackLayout Spacing="12"><Label Text="{Binding Product.Name}" Style="{StaticResource TitleStyle}" HorizontalTextAlignment="Center"/><Label Text="{Binding Product.Rating, StringFormat='★ {0:F1} rating'}" TextColor="{StaticResource Amber}" HorizontalTextAlignment="Center"/><HorizontalStackLayout HorizontalOptions="Center" Spacing="8"><Button Text="Small" Command="{Binding SetSizeCommand}" CommandParameter="Small" BackgroundColor="White" TextColor="{StaticResource CoffeeBrown}"/><Button Text="Medium" Command="{Binding SetSizeCommand}" CommandParameter="Medium" BackgroundColor="{StaticResource Amber}" TextColor="{StaticResource CoffeeBrown}"/><Button Text="Large" Command="{Binding SetSizeCommand}" CommandParameter="Large" BackgroundColor="White" TextColor="{StaticResource CoffeeBrown}"/></HorizontalStackLayout><Grid ColumnDefinitions="*,Auto" VerticalOptions="Center"><VerticalStackLayout><Label Text="Quantity" TextColor="#8B6B55"/><Label Text="{Binding Price, StringFormat='${0:F2}'}" FontSize="23" FontAttributes="Bold" TextColor="{StaticResource CoffeeBrown}"/></VerticalStackLayout><HorizontalStackLayout Grid.Column="1" Spacing="12"><Button Text="−" Command="{Binding DecreaseQuantityCommand}" BackgroundColor="White" TextColor="{StaticResource CoffeeBrown}"/><Label Text="{Binding Quantity}" VerticalOptions="Center" FontSize="18"/><Button Text="+" Command="{Binding IncreaseQuantityCommand}" BackgroundColor="White" TextColor="{StaticResource CoffeeBrown}"/></HorizontalStackLayout></Grid><Label Text="{Binding Product.Description}" MaxLines="{Binding IsDescriptionExpanded, Converter={StaticResource BoolToIntConverter}}" TextColor="#6F4E37"/><Button Text="Add to cart" Command="{Binding AddToCartCommand}" Style="{StaticResource PillButtonStyle}" HeightRequest="52"/></VerticalStackLayout></Border></Grid>
</ContentPage>