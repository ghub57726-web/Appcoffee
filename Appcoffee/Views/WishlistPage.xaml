<?xml version="1.0" encoding="utf-8" ?><ContentPage x:Class="Appcoffee.Views.WishlistPage" x:Name="Page" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" BackgroundColor="{StaticResource Cream}"><Grid RowDefinitions="Auto,*" Padding="20,15"><Grid ColumnDefinitions="Auto,*"><Button Text="‹" Command="{Binding GoBackCommand}" BackgroundColor="Transparent" TextColor="{StaticResource CoffeeBrown}" FontSize="30" Padding="0"/><Label Grid.Column="1" Text="Wishlist" Style="{StaticResource TitleStyle}"/></Grid><CollectionView Grid.Row="1" ItemsSource="{Binding Items}" EmptyView="Your favorite coffees will appear here." Margin="0,15"><CollectionView.ItemTemplate><DataTemplate><Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="10" Margin="0,5"><Grid ColumnDefinitions="80,*,Auto"><Image Source="{Binding Image}" HeightRequest="70"/><VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="{Binding Name}" FontAttributes="Bold" TextColor="{StaticResource CoffeeBrown}"/><Label Text="{Binding BasePrice, StringFormat='${0:F2}'}" TextColor="#8B6B55"/></VerticalStackLayout><Label Grid.Column="2" Text="♥" TextColor="#B33A3A" FontSize="25" VerticalOptions="Center"/><Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenProductCommand}" CommandParameter="{Binding .}"/></Grid.GestureRecognizers></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid></ContentPage>