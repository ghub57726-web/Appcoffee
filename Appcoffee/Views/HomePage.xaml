<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Appcoffee.Views.HomePage" x:Name="Page" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" BackgroundColor="{StaticResource Cream}" Shell.NavBarIsVisible="False">
 <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="20,18,20,0">
  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,15"><VerticalStackLayout><Label Text="Good morning" FontSize="14" TextColor="#8B6B55"/><Label Text="Find your favorite coffee" Style="{StaticResource TitleStyle}" FontSize="22"/></VerticalStackLayout><Label Grid.Column="1" Text="☕" FontSize="36" VerticalOptions="Center"/></Grid>
  <Grid Grid.Row="1" ColumnDefinitions="*,52" ColumnSpacing="10"><Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 16"><SearchBar Placeholder="Search coffee" Text="{Binding SearchText}" BackgroundColor="Transparent"/></Border><Button Grid.Column="1" Text="☰" Command="{Binding ToggleFilterCommand}" BackgroundColor="{StaticResource CoffeeBrown}" TextColor="White" CornerRadius="16"/></Grid>
  <Border Grid.Row="2" BackgroundColor="{StaticResource CoffeeBrown}" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="20" Margin="0,18,0,15"><Grid ColumnDefinitions="*,120"><VerticalStackLayout Spacing="7"><Label Text="Buy one, Get one" TextColor="{StaticResource Amber}" FontSize="21" FontAttributes="Bold"/><Label Text="For free today" TextColor="White"/><Button Text="Order Now" Command="{Binding SeeAllCommand}" HorizontalOptions="Start" Padding="18,5" HeightRequest="38"/></VerticalStackLayout><Image Grid.Column="1" Source="coffee_placeholder.svg" HeightRequest="110"/></Grid></Border>
  <ScrollView Grid.Row="3" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"><HorizontalStackLayout Spacing="10"><BindableLayout.ItemsSource><Binding Path="Categories"/></BindableLayout.ItemsSource><BindableLayout.ItemTemplate><DataTemplate><Button Text="{Binding .}" Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectCategoryCommand}" CommandParameter="{Binding .}" BackgroundColor="White" TextColor="{StaticResource CoffeeBrown}" CornerRadius="18" Padding="18,4" HeightRequest="40"/></DataTemplate></BindableLayout.ItemTemplate></HorizontalStackLayout></ScrollView>
  <Grid Grid.Row="4" RowDefinitions="Auto,*" Margin="0,15,0,10"><Grid ColumnDefinitions="*,Auto"><Label Text="Popular Coffees" Style="{StaticResource TitleStyle}" FontSize="20"/><Button Grid.Column="1" Text="See all" Command="{Binding SeeAllCommand}" BackgroundColor="Transparent" TextColor="#8B6B55" Padding="0"/></Grid><CollectionView Grid.Row="1" ItemsSource="{Binding FilteredProducts}" ItemsLayout="VerticalGrid,2" SelectionMode="None" Margin="0,10,0,0"><CollectionView.ItemTemplate><DataTemplate><Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 18" Margin="4,4" Padding="8"><Grid RowDefinitions="140,Auto,Auto" ColumnDefinitions="*,40"><Image Source="{Binding Image}" Grid.ColumnSpan="2" Aspect="AspectFit"/><Label Grid.Row="1" Text="{Binding Name}" FontAttributes="Bold" TextColor="{StaticResource CoffeeBrown}"/><Label Grid.Row="2" Text="{Binding BasePrice, StringFormat='${0:F2}'}" TextColor="#8B6B55"/><Button Grid.Row="2" Grid.Column="1" Text="+" Command="{Binding Source={x:Reference Page}, Path=BindingContext.AddToCartCommand}" CommandParameter="{Binding .}" WidthRequest="36" HeightRequest="36" CornerRadius="18" Padding="0"/></Grid><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenProductCommand}" CommandParameter="{Binding .}"/></Border.GestureRecognizers></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
  <Grid Grid.Row="5" BackgroundColor="{StaticResource CoffeeBrown}" Padding="4,8" ColumnDefinitions="*,*,*,*,*"><Button Text="⌂" TextColor="{StaticResource Amber}" BackgroundColor="Transparent"/><Button Grid.Column="1" Text="🛒" Command="{Binding OpenCartCommand}" BackgroundColor="Transparent" TextColor="White"/><Button Grid.Column="2" Text="♡" Command="{Binding OpenWishlistCommand}" BackgroundColor="Transparent" TextColor="White"/><Button Grid.Column="3" Text="▣" Command="{Binding OpenOrdersCommand}" BackgroundColor="Transparent" TextColor="White"/><Button Grid.Column="4" Text="●" BackgroundColor="Transparent" TextColor="White"/></Grid>
 </Grid>
</ContentPage>